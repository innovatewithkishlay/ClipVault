{
  "expo": {
    "name": "ClipVault",
    "slug": "ClipVault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/clipboardjs-tile.png",
    "scheme": "clipvault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/clipboardjs-tile.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kishlay_012.ClipVault"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/clipboardjs-tile.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/clipboardjs-tile.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f0cdb21-1f2b-4571-8b78-f088db615b0b"
      }
    }
  }
}
